diff --git a/packages/experimental/tool-agent-team/src/spawn-selection.ts b/packages/experimental/tool-agent-team/src/spawn-selection.ts
new file mode 100644
index 0000000..e62b886
--- /dev/null
+++ b/packages/experimental/tool-agent-team/src/spawn-selection.ts
@@ -0,0 +1,44 @@
+/** Resolve an optional explicit child model route for one teammate spawn. */
+
+import type { AgentOptions } from '@deepseek-ai/dsh-agent'
+import { ReasoningEffortId } from '@deepseek-ai/dsh-llm'
+
+/** Model-facing route fields accepted by `spawn_teammate`. */
+export interface SpawnModelSelection {
+  readonly provider?: string
+  readonly model?: string
+  readonly reasoning_effort?: string
+}
+
+/**
+ * Build child agent options for one teammate spawn.
+ * @param selection - model-facing route fields from the tool call.
+ * @returns the child route, or undefined when the spawn inherits the Lead route.
+ * @throws when provider and model are not supplied together or a supplied value is blank.
+ */
+export function resolveSpawnAgentOptions(selection: SpawnModelSelection): AgentOptions | undefined {
+  const provider = optionalNonEmpty(selection.provider, 'provider')
+  const model = optionalNonEmpty(selection.model, 'model')
+  const effort = optionalNonEmpty(selection.reasoning_effort, 'reasoning_effort')
+  if (provider === undefined && model === undefined && effort === undefined) return undefined
+  if (provider === undefined || model === undefined) {
+    throw new Error('child LLM `provider` and `model` must be supplied together')
+  }
+  return {
+    provider,
+    model,
+    ...effort === undefined ? {} : { reasoningEffort: ReasoningEffortId(effort) },
+  }
+}
+
+/**
+ * Reject a present but blank model-facing value.
+ * @param value - candidate field value.
+ * @param field - field name used in the diagnostic.
+ * @returns the value, or undefined when omitted.
+ */
+function optionalNonEmpty(value: string | undefined, field: string): string | undefined {
+  if (value === undefined) return undefined
+  if (value.length === 0) throw new Error(`child LLM \`${field}\` must be non-empty`)
+  return value
+}
diff --git a/packages/experimental/tool-agent-team/tests/spawn-selection.spec.ts b/packages/experimental/tool-agent-team/tests/spawn-selection.spec.ts
new file mode 100644
index 0000000..012d43f
--- /dev/null
+++ b/packages/experimental/tool-agent-team/tests/spawn-selection.spec.ts
@@ -0,0 +1,25 @@
+import { describe, expect, it } from 'vitest'
+import { resolveSpawnAgentOptions } from '../src/spawn-selection.ts'
+
+describe('resolveSpawnAgentOptions', () => {
+  it('returns undefined when no route is requested', () => {
+    expect(resolveSpawnAgentOptions({})).toBeUndefined()
+  })
+
+  it('builds an exact route with optional effort', () => {
+    expect(resolveSpawnAgentOptions({ provider: 'p', model: 'm' })).toEqual({ provider: 'p', model: 'm' })
+    expect(resolveSpawnAgentOptions({ provider: 'p', model: 'm', reasoning_effort: 'high' }))
+      .toMatchObject({ provider: 'p', model: 'm', reasoningEffort: 'high' })
+  })
+
+  it('rejects a partial route', () => {
+    expect(() => resolveSpawnAgentOptions({ provider: 'p' })).toThrow(/together/)
+    expect(() => resolveSpawnAgentOptions({ model: 'm' })).toThrow(/together/)
+    expect(() => resolveSpawnAgentOptions({ reasoning_effort: 'high' })).toThrow(/together/)
+  })
+
+  it('rejects a blank supplied value', () => {
+    expect(() => resolveSpawnAgentOptions({ provider: '', model: 'm' })).toThrow(/non-empty/)
+    expect(() => resolveSpawnAgentOptions({ provider: 'p', model: 'm', reasoning_effort: '' })).toThrow(/non-empty/)
+  })
+})
